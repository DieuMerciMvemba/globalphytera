# ==========================================
# PHYTERA BACKEND - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN="*"

# Database (Prisma / PostgreSQL / Supabase)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"

# Supabase URL
SUPABASE_URL="https://vjycpccanjugrdkqlemu.supabase.co"

# Redis (Caching, Socket.io Adapter & Task Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# JWT Authentication
JWT_SECRET=phytera_production_secret_jwt_key_2026_secured_token
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=phytera_production_refresh_jwt_key_2026_secured_token
JWT_REFRESH_EXPIRATION=30d

# Swagger Documentation
SWAGGER_PATH=api/docs
